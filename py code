JOB_CHUNKS: List[Dict[str, str]] = []


# ---------------------------------------------------------
# PDF EXTRACTION
# ---------------------------------------------------------

def extract_pdf_text(file_path: Path) -> str:

    reader = PdfReader(str(file_path))

    pages = []

    for page in reader.pages:
        pages.append(page.extract_text() or "")

    return "\n".join(pages)


# ---------------------------------------------------------
# TEXT NORMALIZATION
# ---------------------------------------------------------

def normalize(text: str) -> str:

    text = text.lower()

    text = re.sub(r"\s+", " ", text)

    return text.strip()


# ---------------------------------------------------------
# SKILL EXTRACTION
# ---------------------------------------------------------

def extract_skills(text: str) -> List[str]:

    text = normalize(text)

    detected_skills = []

    for skill in SKILLS:

        if skill.lower() in text:

            detected_skills.append(skill)

    return sorted(detected_skills)


# ---------------------------------------------------------
# TEXT CHUNKING
# ---------------------------------------------------------

def chunk_text(
    text: str,
    chunk_size: int = 900,
    overlap: int = 150
):

    words = text.split()

    chunks = []

    start = 0

    while start < len(words):

        end = min(
            len(words),
            start + chunk_size
        )

        chunk = " ".join(words[start:end])

        chunks.append(chunk)

        if end == len(words):
            break

        start = end - overlap

    return chunks


# ---------------------------------------------------------
# RAG RETRIEVAL
# ---------------------------------------------------------

def retrieve_relevant_context(
    query: str,
    top_k: int = 5
):

    if not JOB_CHUNKS:
        return []

    documents = [
        item["text"]
        for item in JOB_CHUNKS
    ]

    vectorizer = TfidfVectorizer(
        stop_words="english"
    )

    matrix = vectorizer.fit_transform(
        documents + [query]
    )

    similarity_scores = cosine_similarity(
        matrix[-1],
        matrix[:-1]
    ).flatten()

    indices = similarity_scores.argsort()[::-1][:top_k]

    results = []

    for index in indices:

        if similarity_scores[index] > 0:

            results.append(
                {
                    "score": round(
                        float(similarity_scores[index]),
                        3
                    ),
                    "source": JOB_CHUNKS[index]["source"],
                    "text": JOB_CHUNKS[index]["text"]
                }
            )

    return results


# ---------------------------------------------------------
# RESUME SCORE
# ---------------------------------------------------------

def calculate_resume_score(
    resume_skills,
    job_skills
):

    if not job_skills:

        return 70

    resume_set = set(resume_skills)

    job_set = set(job_skills)

    matched = resume_set.intersection(job_set)

    score = (
        len(matched) /
        len(job_set)
    ) * 100

    return max(
        0,
        min(
            100,
            round(score)
        )
    )


# ---------------------------------------------------------
# LEARNING PLAN
# ---------------------------------------------------------

def generate_learning_plan(
    missing_skills,
    role
):

    focus_skills = missing_skills[:8]

    if not focus_skills:

        focus_skills = [
            "advanced projects",
            "system design",
            "interview practice"
        ]

    month_1 = focus_skills[:3]

    month_2 = focus_skills[3:6]

    month_3 = focus_skills[6:8]

    if not month_2:
        month_2 = month_1

    if not month_3:
        month_3 = month_1

    return [

        {
            "title": "Month 1 — Foundation",

            "skills": month_1,

            "action":
                "Study the fundamentals, "
                "complete small exercises, "
                "and create concise notes."
        },

        {
            "title": "Month 2 — Projects",

            "skills": month_2,

            "action":
                "Build a role-related project "
                "and add measurable outcomes "
                "to your resume."
        },

        {
            "title": "Month 3 — Interview Ready",

            "skills": month_3,

            "action":
                "Practice DSA, technical questions, "
                "behavioral questions and mock interviews."
        }

    ]


# ---------------------------------------------------------
# RESUME ANALYZER
# ---------------------------------------------------------

def analyze_resume(
    resume_text,
    target_role,
    job_text
):

    resume_skills = extract_skills(
        resume_text
    )

    retrieved_context = retrieve_relevant_context(
        job_text or target_role
    )

    retrieved_text = "\n".join(
        item["text"]
        for item in retrieved_context
    )

    effective_job_text = (
        job_text
        if job_text.strip()
        else retrieved_text
    )

    job_skills = extract_skills(
        effective_job_text
    )

    resume_skill_set = set(
        resume_skills
    )

    job_skill_set = set(
        job_skills
    )

    matched_skills = sorted(
        resume_skill_set.intersection(
            job_skill_set
        )
    )

    missing_skills = sorted(
        job_skill_set.difference(
            resume_skill_set
        )
    )

    score = calculate_resume_score(
        resume_skills,
        job_skills
    )

    if score >= 80:

        verdict = "Strong alignment"

    elif score >= 60:

        verdict = "Good foundation"

    elif score >= 40:

        verdict = "Needs targeted upskilling"

    else:

        verdict = "Significant skill gap"

    reviewer = [

        f"Target role: {target_role}",

        f"Detected {len(resume_skills)} skills "
        "in your resume.",

        f"Detected {len(job_skills)} "
        "role-related skills.",

        "Add measurable achievements "
        "to your project and experience bullets.",

        "Prioritize the missing skills "
        "before applying to highly competitive roles."

    ]

    interview_roadmap = [

        "Study the missing technical skills "
        "and understand their practical applications.",

        "Prepare five project stories using "
        "Problem → Approach → Result.",

        "Practice DSA and problem-solving "
        "regularly.",

        "Prepare behavioral questions about "
        "teamwork, leadership and challenges.",

        "Complete mock interviews and "
        "update your resume based on feedback."

    ]

    learning_plan = generate_learning_plan(
        missing_skills,
        target_role
    )

    career_advice = (

        f"For a {target_role} role, "
        f"your first priority should be: "
        f"{', '.join(missing_skills[:5])}"
        if missing_skills
        else
        f"For a {target_role} role, focus on "
        "stronger project evidence and interview practice."
    )

    return {

        "resume_score": score,

        "verdict": verdict,

        "matched_skills": matched_skills,

        "missing_skills": missing_skills,

        "resume_skills": resume_skills,

        "reviewer": reviewer,

        "career_advisor": career_advice,

        "interview_roadmap": interview_roadmap,

        "three_month_plan": learning_plan,

        "retrieved_context": retrieved_context,

        "rag_used": bool(
            retrieved_context
        ),

        "prompt_template": (

            "You are an expert resume reviewer "
            "and career advisor. Compare the "
            "resume with the retrieved job "
            "description context. Identify "
            "relevant strengths, missing skills, "
            "resume improvements and interview "
            "preparation requirements."
        )

    }



# ANALYZE RESUME API
# ---------------------------------------------------------

@app.post("/api/analyze")
async def analyze_api(

    resume_file: UploadFile | None =
        File(default=None),

    resume_text: str =
        Form(""),

    target_role: str =
        Form("Software Engineer"),

    job_text: str =
        Form("")

):

    text = resume_text.strip()

    # If PDF uploaded
    if resume_file and resume_file.filename:

        if not resume_file.filename.lower().endswith(".pdf"):

            raise HTTPException(
                status_code=400,
                detail="Resume must be a PDF."
            )

        file_path = (
            UPLOAD_DIR /
            f"{uuid.uuid4()}_{resume_file.filename}"
        )

        file_path.write_bytes(
            await resume_file.read()
        )

        text = extract_pdf_text(
            file_path
        )

    if len(text) < 30:

        raise HTTPException(
            status_code=400,
            detail=
            "Please upload a resume PDF "
            "or paste your resume text."
        )

    return analyze_resume(
        text,
        target_role,
        job_text
    )



* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


:root {

    --background: #f7f7fb;
    --card: #ffffff;
    --text: #171722;
    --muted: #747582;
    --border: #e7e7ee;
    --primary: #5b5ce2;
    --primary-light: #eeeeff;
    --green: #16805c;
    --red: #c9473d;

}


body {

    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: var(--background);

    color: var(--text);

    line-height: 1.5;

}


.navbar {

    height: 70px;

    background: white;

    border-bottom:
        1px solid var(--border);

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 0 7%;

}


.logo {

    font-size: 21px;

    font-weight: 800;

}


.logo:first-letter {

    color: var(--primary);

}


.nav-badge {

    border:
        1px solid var(--border);

    border-radius: 50px;

    padding: 7px 13px;

    color: var(--muted);

    font-size: 12px;

}


.container {

    width: min(
        1100px,
        92%
    );

    margin: auto;

    padding: 55px 0;

}


.hero {

    margin-bottom: 45px;

}


.eyebrow {

    color: var(--primary);

    font-size: 11px;

    font-weight: 800;

    letter-spacing: .15em;

    margin-bottom: 10px;

}


.hero h1 {

    font-size:
        clamp(
            40px,
            7vw,
            70px
        );

    line-height: 1.02;

    letter-spacing: -3px;

    margin-bottom: 20px;

}


.hero-description {

    max-width: 700px;

    font-size: 18px;

    color: var(--muted);

}


.input-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 18px;

}


.card {

    background:
        var(--card);

    border:
        1px solid var(--border);

    border-radius: 18px;

    padding: 25px;

    box-shadow:
        0 8px 30px
        rgba(20,20,40,.035);

}


.full {

    grid-column: 1 / -1;

}


.card-number {

    color: var(--primary);

    font-size: 12px;

    font-weight: 800;

    margin-bottom: 10px;

}


.card h2 {

    font-size: 21px;

    margin-bottom: 7px;

}


.card h3 {

    font-size: 18px;

    margin-bottom: 17px;

}


.muted {

    color: var(--muted);

}


input,
textarea {

    width: 100%;

    border:
        1px solid var(--border);

    background: #fbfbfd;

    border-radius: 11px;

    padding: 13px;

    font: inherit;

    margin-top: 10px;

    outline: none;

}


input:focus,
textarea:focus {

    border-color:
        var(--primary);

}


textarea {

    min-height: 155px;

    resize: vertical;

}


label {

    display: block;

    margin-top: 18px;

    font-size: 13px;

    font-weight: 700;

}


.upload-area {

    display: flex;

    gap: 10px;

    align-items: center;

}


.upload-area input {

    flex: 1;

}


button {

    border: none;

    font: inherit;

    font-weight: 750;

    cursor: pointer;

    border-radius: 11px;

    transition:
        .2s ease;

}


.secondary-btn {

    padding: 13px 18px;

    background:
        var(--primary-light);

    color:
        var(--primary);

    white-space: nowrap;

}


.secondary-btn:hover {

    transform:
        translateY(-1px);

}


.analyze-btn {

    width: 100%;

    background:
        var(--primary);

    color: white;

    padding: 17px;

    font-size: 16px;

    margin: 22px 0;

}


.analyze-btn:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 10px 25px
        rgba(91,92,226,.2);

}


.analyze-btn span {

    margin-left: 8px;

}


.loading {

    text-align: center;

    padding: 20px;

    color: var(--muted);

}


.spinner {

    width: 24px;

    height: 24px;

    border:
        3px solid #ddd;

    border-top-color:
        var(--primary);

    border-radius: 50%;

    animation:
        spin 1s linear infinite;

    margin:
        auto auto 10px;

}


@keyframes spin {

    to {
        transform:
            rotate(360deg);
    }

}


.hidden {

    display: none !important;

}


.results {

    margin-top: 25px;

}


.score-card {

    background: white;

    border:
        1px solid var(--border);

    border-radius: 20px;

    padding: 30px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 18px;

}


.score-card h2 {

    margin-bottom: 5px;

}


.score-circle {

    width: 125px;

    height: 125px;

    border-radius: 50%;

    background:
        var(--primary-light);

    color:
        var(--primary);

    display: flex;

    align-items: center;

    justify-content: center;

    flex-direction: column;

}


.score-circle span {

    font-size: 42px;

    font-weight: 850;

}


.score-circle small {

    color: var(--muted);

}


.result-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 18px;

    margin-bottom: 18px;

}


.chips {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

}


.chip {

    padding: 8px 12px;

    border-radius: 50px;

    background: #f0f1f5;

    font-size: 13px;

}


.chip.good {

    background: #e9f8f1;

    color: var(--green);

}


.chip.missing {

    background: #fff0ef;

    color: var(--red);

}


.result-list {

    padding-left: 21px;

}


.result-list li {

    margin: 10px 0;

}


.plan {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 14px;

}


.plan-item {

    border:
        1px solid var(--border);

    border-radius: 14px;

    padding: 18px;

}


.plan-item h4 {

    margin-bottom: 12px;

}


.plan-item ul {

    padding-left: 18px;

    font-size: 13px;

}


.plan-item li {

    margin: 6px 0;

}


.plan-item p {

    color: var(--muted);

    font-size: 13px;

    margin-top: 13px;

}


.context-item {

    padding: 14px;

    border-left:
        3px solid var(--primary);

    background:
        #fafaff;

    border-radius: 7px;

    margin: 10px 0;

    font-size: 13px;

}


footer {

    border-top:
        1px solid var(--border);

    text-align: center;

    padding: 30px;

    color: var(--muted);

    font-size: 12px;

}


/* MOBILE */

@media (max-width: 750px) {

    .input-grid,
    .result-grid,
    .plan {

        grid-template-columns:
            1fr;

    }


    .full {

        grid-column:
            auto;

    }


    .hero h1 {

        letter-spacing:
            -2px;

    }


    .score-card {

        align-items:
            flex-start;

        gap: 20px;

    }


    .upload-area {

        flex-direction:
            column;

        align-items:
            stretch;

    }

}
